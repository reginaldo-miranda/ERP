@inherits LayoutComponentBase
@using ERP.Web.Services
@inject CustomAuthStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (IsLoginPage)
{
    @Body
}
else
{
    <MudLayout>
        <MudAppBar Elevation="2" Color="Color.Surface">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            <MudText Typo="Typo.h6" Class="ml-3 font-weight-bold" Color="Color.Primary">ERP Multi-Empresa</MudText>

            <MudSpacer />

            <!-- Seletor de Empresa Ativa -->
            <MudMenu Label="@AuthState.EmpresaAtivaNome" Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Variant="Variant.Outlined" Class="mr-3" Dense="true">
                @if (AuthState.EmpresasDisponiveis.Any())
                {
                    @foreach (var emp in AuthState.EmpresasDisponiveis)
                    {
                        var nome = emp.NomeFantasia ?? emp.RazaoSocial;
                        var estaAtiva = emp.Id == AuthState.EmpresaAtivaId;
                        <MudMenuItem Icon="@(estaAtiva ? Icons.Material.Filled.Check : Icons.Material.Filled.Business)" 
                                     OnClick="@(() => SelecionarEmpresa(emp.Id, nome))">
                            @nome
                        </MudMenuItem>
                    }
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Check" OnClick="@(() => SelecionarEmpresa(1, "Empresa Matriz Padrão S.A."))">
                        Empresa Matriz Padrão S.A.
                    </MudMenuItem>
                }
            </MudMenu>

            <!-- Sino de Notificações -->
            <MudBadge Content="3" Color="Color.Error" Overlap="true" Class="mr-3">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Href="/notificacoes" />
            </MudBadge>

            <!-- Toggle de Tema Dark / Light -->
            <MudTooltip Text="Alternar Tema">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                               Color="Color.Inherit" 
                               OnClick="@ToggleTheme" 
                               Class="mr-2" />
            </MudTooltip>

            <!-- Menu de Perfil do Usuário -->
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Disabled="true">
                    <MudText Typo="Typo.body2"><b>@(AuthState.Usuario?.NomeCompleto ?? "Administrador do Sistema")</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(AuthState.Usuario?.Email ?? "admin@erp.com")</MudText>
                    @if (AuthState.Usuario?.Papeis != null && AuthState.Usuario.Papeis.Any())
                    {
                        <div class="mt-1">
                            @foreach (var p in AuthState.Usuario.Papeis)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mr-1">@p</MudChip>
                            }
                        </div>
                    }
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/perfil">Meu Perfil</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="RealizarLogout">
                    <MudText Color="Color.Error">Sair</MudText>
                </MudMenuItem>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
            <NavMenu />
        </MudDrawer>

        <MudMainContent Class="pa-6">
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true; // Tema Dark por padrão

    private bool IsLoginPage => Nav.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase);

    private readonly MudTheme _customTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#3B82F6",
            Secondary = "#10B981",
            AppbarBackground = "#1F2937",
            Background = "#111827",
            Surface = "#1F2937",
            DrawerBackground = "#1F2937",
            DrawerText = "#F3F4F6",
            TextPrimary = "#F9FAFB",
            TextSecondary = "#9CA3AF"
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563EB",
            Secondary = "#059669",
            AppbarBackground = "#FFFFFF",
            Background = "#F3F4F6",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#111827",
            TextSecondary = "#4B5563"
        }
    };

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private async Task SelecionarEmpresa(int id, string nome)
    {
        await AuthState.TrocarEmpresaAsync(id, nome);
        Snackbar.Add($"Empresa ativa alternada para: {nome}", Severity.Info);
        StateHasChanged();
    }

    private async Task RealizarLogout()
    {
        await AuthState.LogoutAsync();
        Snackbar.Add("Sessão finalizada com sucesso.", Severity.Info);
        Nav.NavigateTo("/login");
    }
}
