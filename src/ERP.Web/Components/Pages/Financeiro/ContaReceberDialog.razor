@using ERP.Application.Cadastros.Clientes.DTOs
@using ERP.Application.Cadastros.Clientes.Queries
@using ERP.Application.Financeiro.Cadastros.DTOs
@using ERP.Application.Financeiro.Cadastros.Queries
@using ERP.Application.Financeiro.ContasReceber.Commands
@using ERP.Domain.Core.Enums
@using MediatR
@inject IMediator Mediator

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="Icons.Material.Filled.PostAdd" Class="mr-2" />
            Nova Conta a Receber
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField T="string" Label="Descrição / Histórico" @bind-Value="_descricao" Required="true"
                              Placeholder="Ex: Venda de mercadorias, Prestação de consultoria, etc." />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField T="string" Label="Nº Documento / Pedido" @bind-Value="_numeroDocumento" Placeholder="Ex: PED-1002" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="int?" Label="Cliente" @bind-Value="_clienteId" Clearable="true">
                    @foreach (var c in _clientes)
                    {
                        <MudSelectItem Value="@((int?)c.Id)">@c.Nome (@c.CpfCnpj)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" Label="Valor Total (R$)" @bind-Value="_valorTotal" Required="true" Min="0.01m"
                                 Format="N2" Culture="@(new System.Globalization.CultureInfo("pt-BR"))" OnBlur="AtualizarPreviaParcelas" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker Label="Data de Emissão" @bind-Date="_dataEmissao" Editable="true" DateFormat="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudDatePicker Label="Primeiro Vencimento" @bind-Date="_primeiroVencimento" Required="true" Editable="true" DateFormat="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="int?" Label="Plano de Contas (Receita)" @bind-Value="_planoContaId" Clearable="true">
                    @foreach (var p in _planosContas)
                    {
                        <MudSelectItem Value="@((int?)p.Id)">@p.Codigo - @p.Descricao</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="int?" Label="Centro de Custo" @bind-Value="_centroCustoId" Clearable="true">
                    @foreach (var c in _centrosCusto)
                    {
                        <MudSelectItem Value="@((int?)c.Id)">@c.Codigo - @c.Descricao</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="int?" Label="Forma de Recebimento Prevista" @bind-Value="_formaPagamentoId" Clearable="true">
                    @foreach (var f in _formasPagamento)
                    {
                        <MudSelectItem Value="@((int?)f.Id)">@f.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_parcelar" Label="Parcelar este título em várias vezes" Color="Color.Success" />
            </MudItem>

            @if (_parcelar)
            {
                <MudItem xs="12" md="6">
                    <MudNumericField T="int" Label="Quantidade de Parcelas" @bind-Value="_numeroParcelas" Min="2" Max="60"
                                     OnBlur="AtualizarPreviaParcelas" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudNumericField T="int" Label="Intervalo de Dias entre Parcelas" @bind-Value="_intervaloDias" Min="1" Max="365"
                                     OnBlur="AtualizarPreviaParcelas" HelperText="Ex: 30 para mensal" />
                </MudItem>

                @if (_previaParcelas.Any())
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Prévia das Parcelas:</MudText>
                        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="max-height: 200px; overflow-y: auto;">
                            <thead>
                                <tr>
                                    <th>Parcela</th>
                                    <th>Vencimento</th>
                                    <th class="text-right">Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _previaParcelas)
                                {
                                    <tr>
                                        <td>@p.Numero/@_numeroParcelas</td>
                                        <td>@p.Vencimento.ToString("dd/MM/yyyy")</td>
                                        <td class="text-right">@p.Valor.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudItem>
                }
            }

            <MudItem xs="12">
                <MudTextField T="string" Label="Observações adicionais" @bind-Value="_observacoes" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Salvar" Disabled="@(!PodeSalvar)">
            @(_parcelar ? $"Salvar {_numeroParcelas} Parcelas" : "Salvar Conta")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _descricao = string.Empty;
    private string? _numeroDocumento;
    private int? _clienteId;
    private decimal _valorTotal;
    private DateTime? _dataEmissao = DateTime.Today;
    private DateTime? _primeiroVencimento = DateTime.Today.AddDays(30);
    private int? _planoContaId;
    private int? _centroCustoId;
    private int? _formaPagamentoId;
    private string? _observacoes;

    private bool _parcelar = false;
    private int _numeroParcelas = 2;
    private int _intervaloDias = 30;

    private List<ClienteListItemDto> _clientes = new();
    private List<PlanoContaDto> _planosContas = new();
    private List<CentroCustoDto> _centrosCusto = new();
    private List<FormaPagamentoDto> _formasPagamento = new();
    private List<PreviaParcela> _previaParcelas = new();

    private bool PodeSalvar => !string.IsNullOrWhiteSpace(_descricao) && _valorTotal > 0 && _primeiroVencimento.HasValue;

    protected override async Task OnInitializedAsync()
    {
        var cliRes = await Mediator.Send(new GetClientesQuery(Ativo: true, TamanhoPagina: 200));
        _clientes = cliRes.Itens.ToList();

        _planosContas = await Mediator.Send(new GetPlanosContasQuery(Tipo: TipoPlanoConta.Receita, SomenteAnaliticas: true));
        _centrosCusto = await Mediator.Send(new GetCentrosCustoQuery());
        _formasPagamento = await Mediator.Send(new GetFormasPagamentoQuery());

        AtualizarPreviaParcelas();
    }

    private void AtualizarPreviaParcelas()
    {
        _previaParcelas.Clear();
        if (_valorTotal <= 0 || !_primeiroVencimento.HasValue) return;

        var qtd = _parcelar ? _numeroParcelas : 1;
        var intervalo = _parcelar ? _intervaloDias : 0;
        var valorBase = Math.Round(_valorTotal / qtd, 2);
        var diferenca = _valorTotal - (valorBase * qtd);

        for (int i = 1; i <= qtd; i++)
        {
            var valor = valorBase;
            if (i == 1) valor += diferenca;
            var dt = _primeiroVencimento.Value.AddDays((i - 1) * intervalo);
            _previaParcelas.Add(new PreviaParcela(i, dt, valor));
        }
        StateHasChanged();
    }

    private void Salvar()
    {
        if (!PodeSalvar) return;

        var cmd = new CreateContaReceberCommand(
            _clienteId,
            _descricao,
            _valorTotal,
            _dataEmissao ?? DateTime.Today,
            _primeiroVencimento ?? DateTime.Today,
            _dataEmissao,
            _formaPagamentoId,
            null,
            _planoContaId,
            _centroCustoId,
            _numeroDocumento,
            _parcelar ? _numeroParcelas : 1,
            _parcelar ? _intervaloDias : 30,
            _observacoes
        );

        MudDialog.Close(DialogResult.Ok(cmd));
    }

    private void Cancelar() => MudDialog.Cancel();

    private record PreviaParcela(int Numero, DateTime Vencimento, decimal Valor);
}
