@using ERP.Application.Financeiro.Cadastros.Commands
@using ERP.Application.Financeiro.Cadastros.DTOs
@using ERP.Application.Financeiro.Cadastros.Queries
@using ERP.Domain.Core.Enums
@using MediatR
@inject IMediator Mediator

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="Icons.Material.Filled.AccountBalance" Class="mr-2" />
            Nova Conta Bancária / Caixa
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField T="string" Label="Descrição da Conta" @bind-Value="_descricao" Required="true"
                              Placeholder="Ex: Itaú Empresa, Caixa da Loja, etc." />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="TipoContaBancaria" Label="Tipo de Conta" @bind-Value="_tipo">
                    <MudSelectItem Value="TipoContaBancaria.Corrente">Conta Corrente</MudSelectItem>
                    <MudSelectItem Value="TipoContaBancaria.Poupanca">Poupança</MudSelectItem>
                    <MudSelectItem Value="TipoContaBancaria.CaixaFisico">Caixa Físico / Gaveta</MudSelectItem>
                    <MudSelectItem Value="TipoContaBancaria.Investimento">Investimento</MudSelectItem>
                    <MudSelectItem Value="TipoContaBancaria.Outro">Outro</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (_tipo != TipoContaBancaria.CaixaFisico)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" Label="Instituição Bancária" @bind-Value="_bancoId" Clearable="true">
                        @foreach (var b in _bancos)
                        {
                            <MudSelectItem Value="@((int?)b.Id)">@b.Codigo - @(b.NomeReduzido ?? b.Nome)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="6" md="3">
                    <MudTextField T="string" Label="Agência" @bind-Value="_agencia" Placeholder="Ex: 1234" />
                </MudItem>

                <MudItem xs="6" md="3">
                    <MudTextField T="string" Label="Conta Corrente" @bind-Value="_conta" Placeholder="Ex: 56789-0" />
                </MudItem>
            }

            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" Label="Saldo Inicial (R$)" @bind-Value="_saldoInicial"
                                 Format="N2" Culture="@(new System.Globalization.CultureInfo("pt-BR"))" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Observações" @bind-Value="_observacoes" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar" Disabled="@(!PodeSalvar)">
            Salvar Conta
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _descricao = string.Empty;
    private TipoContaBancaria _tipo = TipoContaBancaria.Corrente;
    private int? _bancoId;
    private string? _agencia;
    private string? _conta;
    private decimal _saldoInicial;
    private string? _observacoes;

    private List<BancoDto> _bancos = new();
    private bool PodeSalvar => !string.IsNullOrWhiteSpace(_descricao);

    protected override async Task OnInitializedAsync()
    {
        _bancos = await Mediator.Send(new GetBancosQuery(SomenteAtivos: true));
    }

    private void Salvar()
    {
        if (!PodeSalvar) return;

        var cmd = new CreateContaBancariaCommand(
            _descricao,
            _tipo,
            _bancoId,
            _agencia,
            null,
            _conta,
            null,
            _saldoInicial,
            _observacoes
        );

        MudDialog.Close(DialogResult.Ok(cmd));
    }

    private void Cancelar() => MudDialog.Cancel();
}
