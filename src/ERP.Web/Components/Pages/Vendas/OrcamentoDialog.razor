@using ERP.Application.Common.Interfaces
@using ERP.Application.Vendas.Common
@using ERP.Application.Vendas.DTOs
@using ERP.Domain.Core.Entities.Cadastros
@using ERP.Domain.Core.Enums
@using Microsoft.EntityFrameworkCore
@inject IApplicationDbContext Context
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Large" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@(OrcamentoId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddCircle)" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(OrcamentoId.HasValue ? $"Editar Orçamento {NumeroOrcamento}" : "Novo Orçamento de Venda")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_carregando)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudGrid>
                <!-- Cabeçalho do Orçamento -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Cliente *" @bind-Value="_clienteId" Required="true" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="0" Disabled="true">Selecione um cliente...</MudSelectItem>
                        @foreach (var c in _clientes)
                        {
                            <MudSelectItem Value="@c.Id">@c.Nome @(string.IsNullOrWhiteSpace(c.CpfCnpj) ? "" : $"({c.CpfCnpj})")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Data Emissão *" @bind-Date="_dataOrcamento" Editable="true" DateFormat="dd/MM/yyyy" Dense="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Validade da Proposta *" @bind-Date="_dataValidade" Editable="true" DateFormat="dd/MM/yyyy" Dense="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_vendedorNome" Label="Vendedor / Responsável" Dense="true" Variant="Variant.Outlined" Placeholder="Nome do vendedor" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudSelect T="TipoDescontoVenda" Label="Tipo Desconto Geral" @bind-Value="_descontoTipo" Dense="true" Variant="Variant.Outlined" SelectedValuesChanged="RecalcularTotais">
                        <MudSelectItem Value="TipoDescontoVenda.Valor">Valor (R$)</MudSelectItem>
                        <MudSelectItem Value="TipoDescontoVenda.Percentual">Percentual (%)</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" Label="Desconto Geral" @bind-Value="_descontoGeral" Format="N2" Min="0" Max="1000000" Dense="true" Variant="Variant.Outlined" TextChanged="RecalcularTotais" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_observacao" Label="Observações e Condições Comerciais" Lines="2" Variant="Variant.Outlined" Placeholder="Prazos de entrega, garantias, condições especiais..." />
                </MudItem>

                <!-- Seção de Itens -->
                <MudItem xs="12">
                    <div class="d-flex justify-space-between align-center mt-3 mb-2">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
                            Itens do Orçamento (@_itens.Count)
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AdicionarItem">
                            Adicionar Item
                        </MudButton>
                    </div>

                    <MudTable Items="@_itens" Dense="true" Hover="true" Bordered="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="width: 110px;">Tipo</MudTh>
                            <MudTh>Produto / Serviço</MudTh>
                            <MudTh Style="width: 100px;" class="text-right">Qtd</MudTh>
                            <MudTh Style="width: 120px;" class="text-right">Preço Unit.</MudTh>
                            <MudTh Style="width: 110px;">Desc. Tipo</MudTh>
                            <MudTh Style="width: 100px;" class="text-right">Desc.</MudTh>
                            <MudTh Style="width: 120px;" class="text-right">Subtotal</MudTh>
                            <MudTh Style="width: 50px;" class="text-center"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudSelect T="TipoItemVenda" Value="@context.TipoItem" ValueChanged="@((TipoItemVenda v) => OnTipoItemChanged(context, v))" Dense="true" Margin="Margin.Dense">
                                    <MudSelectItem Value="TipoItemVenda.Produto">Produto</MudSelectItem>
                                    <MudSelectItem Value="TipoItemVenda.Servico">Serviço</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                @if (context.TipoItem == TipoItemVenda.Produto)
                                {
                                    <MudSelect T="int?" Value="@context.ProdutoId" ValueChanged="@((int? id) => OnProdutoChanged(context, id))" Dense="true" Margin="Margin.Dense">
                                        <MudSelectItem T="int?" Value="@((int?)null)" Disabled="true">Selecione o produto...</MudSelectItem>
                                        @foreach (var p in _produtos)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Nome (@p.PrecoVenda.ToString("C2"))</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudSelect T="int?" Value="@context.ServicoId" ValueChanged="@((int? id) => OnServicoChanged(context, id))" Dense="true" Margin="Margin.Dense">
                                        <MudSelectItem T="int?" Value="@((int?)null)" Disabled="true">Selecione o serviço...</MudSelectItem>
                                        @foreach (var s in _servicos)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Nome (@s.PrecoBase.ToString("C2"))</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" @bind-Value="context.Quantidade" Min="0.01m" Format="N2" Dense="true" Margin="Margin.Dense" TextChanged="@(() => OnItemValueChanged(context))" Class="text-right" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" @bind-Value="context.PrecoUnitario" Min="0" Format="N2" Dense="true" Margin="Margin.Dense" TextChanged="@(() => OnItemValueChanged(context))" Class="text-right" />
                            </MudTd>
                            <MudTd>
                                <MudSelect T="TipoDescontoVenda" @bind-Value="context.DescontoTipo" Dense="true" Margin="Margin.Dense" SelectedValuesChanged="@(() => OnItemValueChanged(context))">
                                    <MudSelectItem Value="TipoDescontoVenda.Valor">R$</MudSelectItem>
                                    <MudSelectItem Value="TipoDescontoVenda.Percentual">%</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" @bind-Value="context.Desconto" Min="0" Format="N2" Dense="true" Margin="Margin.Dense" TextChanged="@(() => OnItemValueChanged(context))" Class="text-right" />
                            </MudTd>
                            <MudTd Class="text-right font-weight-bold">
                                @context.SubTotal.ToString("C2")
                            </MudTd>
                            <MudTd Class="text-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoverItem(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>

                <!-- Resumo dos Totais -->
                <MudItem xs="12">
                    <MudCard Elevation="1" Class="pa-4 mt-2" Style="background: var(--mud-palette-background-grey);">
                        <MudGrid Justify="Justify.FlexEnd">
                            <MudItem xs="12" sm="6" md="4">
                                <div class="d-flex justify-space-between mb-1">
                                    <MudText Typo="Typo.body2">Total Bruto dos Itens:</MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@_valorBruto.ToString("C2")</MudText>
                                </div>
                                <div class="d-flex justify-space-between mb-1 text-danger">
                                    <MudText Typo="Typo.body2" Color="Color.Error">Desconto Geral:</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Error" Class="font-weight-bold">- @_valorDescontoGeral.ToString("C2")</MudText>
                                </div>
                                <MudDivider Class="my-2" />
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">VALOR TOTAL:</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@_valorTotal.ToString("C2")</MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="Salvar" Disabled="_carregando || !_itens.Any()">
            Salvar Orçamento
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? OrcamentoId { get; set; }
    [Parameter] public string? NumeroOrcamento { get; set; }

    private bool _carregando = true;
    private int _clienteId;
    private DateTime? _dataOrcamento = DateTime.UtcNow.Date;
    private DateTime? _dataValidade = DateTime.UtcNow.Date.AddDays(15);
    private string? _vendedorNome;
    private TipoDescontoVenda _descontoTipo = TipoDescontoVenda.Valor;
    private decimal _descontoGeral = 0m;
    private string? _observacao;

    private decimal _valorBruto = 0m;
    private decimal _valorDescontoGeral = 0m;
    private decimal _valorTotal = 0m;

    private List<Cliente> _clientes = new();
    private List<Produto> _produtos = new();
    private List<Servico> _servicos = new();

    public class ItemEdicaoModel
    {
        public TipoItemVenda TipoItem { get; set; } = TipoItemVenda.Produto;
        public int? ProdutoId { get; set; }
        public int? ServicoId { get; set; }
        public string Descricao { get; set; } = string.Empty;
        public decimal Quantidade { get; set; } = 1m;
        public decimal PrecoUnitario { get; set; } = 0m;
        public TipoDescontoVenda DescontoTipo { get; set; } = TipoDescontoVenda.Valor;
        public decimal Desconto { get; set; } = 0m;
        public decimal ValorDesconto { get; set; } = 0m;
        public decimal SubTotal { get; set; } = 0m;
    }

    private List<ItemEdicaoModel> _itens = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _carregando = true;
            _clientes = await Context.Clientes.AsNoTracking().Where(c => c.Ativo).OrderBy(c => c.Nome).ToListAsync();
            _produtos = await Context.Produtos.AsNoTracking().Where(p => p.Ativo).OrderBy(p => p.Nome).ToListAsync();
            _servicos = await Context.Servicos.AsNoTracking().Where(s => s.Ativo).OrderBy(s => s.Nome).ToListAsync();

            if (OrcamentoId.HasValue)
            {
                var o = await Context.Orcamentos
                    .Include(o => o.Itens)
                    .FirstOrDefaultAsync(o => o.Id == OrcamentoId.Value);

                if (o != null)
                {
                    _clienteId = o.ClienteId;
                    _dataOrcamento = o.DataOrcamento.ToLocalTime().Date;
                    _dataValidade = o.DataValidade.ToLocalTime().Date;
                    _vendedorNome = o.VendedorNome;
                    _descontoTipo = o.DescontoTipo;
                    _descontoGeral = o.DescontoGeral;
                    _observacao = o.Observacao;

                    _itens = o.Itens.Select(i => new ItemEdicaoModel
                    {
                        TipoItem = i.TipoItem,
                        ProdutoId = i.ProdutoId,
                        ServicoId = i.ServicoId,
                        Descricao = i.Descricao,
                        Quantidade = i.Quantidade,
                        PrecoUnitario = i.PrecoUnitario,
                        DescontoTipo = i.DescontoTipo,
                        Desconto = i.Desconto,
                        ValorDesconto = i.ValorDesconto,
                        SubTotal = i.SubTotal
                    }).ToList();
                }
            }
            else
            {
                AdicionarItem();
            }

            RecalcularTotais();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar dados: {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    private void AdicionarItem()
    {
        var item = new ItemEdicaoModel();
        if (_produtos.Any())
        {
            var p = _produtos.First();
            item.ProdutoId = p.Id;
            item.Descricao = p.Nome;
            item.PrecoUnitario = p.PrecoVenda;
        }
        OnItemValueChanged(item);
        _itens.Add(item);
        RecalcularTotais();
    }

    private void RemoverItem(ItemEdicaoModel item)
    {
        _itens.Remove(item);
        RecalcularTotais();
    }

    private void OnTipoItemChanged(ItemEdicaoModel item, TipoItemVenda tipo)
    {
        item.TipoItem = tipo;
        if (tipo == TipoItemVenda.Produto)
        {
            item.ServicoId = null;
            if (_produtos.Any())
            {
                var p = _produtos.First();
                item.ProdutoId = p.Id;
                item.Descricao = p.Nome;
                item.PrecoUnitario = p.PrecoVenda;
            }
        }
        else
        {
            item.ProdutoId = null;
            if (_servicos.Any())
            {
                var s = _servicos.First();
                item.ServicoId = s.Id;
                item.Descricao = s.Nome;
                item.PrecoUnitario = s.PrecoBase;
            }
        }
        OnItemValueChanged(item);
        RecalcularTotais();
    }

    private void OnProdutoChanged(ItemEdicaoModel item, int? produtoId)
    {
        item.ProdutoId = produtoId;
        var p = _produtos.FirstOrDefault(x => x.Id == produtoId);
        if (p != null)
        {
            item.Descricao = p.Nome;
            item.PrecoUnitario = p.PrecoVenda;
        }
        OnItemValueChanged(item);
        RecalcularTotais();
    }

    private void OnServicoChanged(ItemEdicaoModel item, int? servicoId)
    {
        item.ServicoId = servicoId;
        var s = _servicos.FirstOrDefault(x => x.Id == servicoId);
        if (s != null)
        {
            item.Descricao = s.Nome;
            item.PrecoUnitario = s.PrecoBase;
        }
        OnItemValueChanged(item);
        RecalcularTotais();
    }

    private void OnItemValueChanged(ItemEdicaoModel item)
    {
        var calc = VendaCalculosHelper.CalcularItem(item.Quantidade, item.PrecoUnitario, item.DescontoTipo, item.Desconto);
        item.ValorDesconto = calc.ValorDesconto;
        item.SubTotal = calc.SubTotal;
        RecalcularTotais();
    }

    private void RecalcularTotais()
    {
        var totais = VendaCalculosHelper.CalcularTotais(_itens.Select(i => i.SubTotal), _descontoTipo, _descontoGeral);
        _valorBruto = totais.ValorBruto;
        _valorDescontoGeral = totais.ValorDescontoGeral;
        _valorTotal = totais.ValorTotal;
        StateHasChanged();
    }

    private void Salvar()
    {
        if (_clienteId <= 0)
        {
            Snackbar.Add("Selecione um cliente para o orçamento.", Severity.Warning);
            return;
        }

        if (!_itens.Any())
        {
            Snackbar.Add("Adicione pelo menos um item ao orçamento.", Severity.Warning);
            return;
        }

        foreach (var it in _itens)
        {
            if (it.TipoItem == TipoItemVenda.Produto && !it.ProdutoId.HasValue)
            {
                Snackbar.Add("Selecione o produto para todos os itens do orçamento.", Severity.Warning);
                return;
            }
            if (it.TipoItem == TipoItemVenda.Servico && !it.ServicoId.HasValue)
            {
                Snackbar.Add("Selecione o serviço para todos os itens do orçamento.", Severity.Warning);
                return;
            }
            if (it.Quantidade <= 0)
            {
                Snackbar.Add("A quantidade de cada item deve ser maior que zero.", Severity.Warning);
                return;
            }
        }

        var itensDto = _itens.Select(i => new ItemVendaInputDto(
            i.TipoItem,
            i.ProdutoId,
            i.ServicoId,
            i.Descricao,
            i.Quantidade,
            i.PrecoUnitario,
            i.DescontoTipo,
            i.Desconto
        )).ToList();

        var resultado = new CriarOrcamentoDto(
            _clienteId,
            null,
            _vendedorNome,
            _dataOrcamento ?? DateTime.UtcNow,
            _dataValidade ?? DateTime.UtcNow.AddDays(15),
            _descontoTipo,
            _descontoGeral,
            _observacao,
            itensDto
        );

        MudDialog.Close(DialogResult.Ok(resultado));
    }

    private void Cancelar() => MudDialog.Cancel();
}
