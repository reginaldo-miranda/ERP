@using ERP.Application.Comissoes.Commands
@using ERP.Application.Comissoes.DTOs
@using ERP.Application.Comissoes.Queries
@using ERP.Domain.Core.Enums
@using MediatR
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Rule" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">@(RegraExistente != null ? "Editar Regra de Comissão" : "Nova Regra de Comissão")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_dto.Nome" Label="Nome da Regra *" Required="true" Variant="Variant.Outlined" Dense="true" Placeholder="Ex: Meta Acima de R$ 10.000" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int?" @bind-Value="_dto.VendedorId" Label="Vendedor (deixe vazio para regra Geral)" Variant="Variant.Outlined" Dense="true" Clearable="true">
                    @foreach (var v in _vendedores)
                    {
                        <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.Nome</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="TipoRegraComissao" @bind-Value="_dto.Tipo" Label="Tipo de Cálculo" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem Value="TipoRegraComissao.PercentualSobreVenda">% sobre a Venda</MudSelectItem>
                    <MudSelectItem Value="TipoRegraComissao.ValorFixoPorVenda">Valor Fixo por Venda</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                @if (_dto.Tipo == TipoRegraComissao.PercentualSobreVenda)
                {
                    <MudNumericField T="decimal" @bind-Value="_dto.Percentual" Label="Percentual (%)" Format="N2" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else
                {
                    <MudNumericField T="decimal" @bind-Value="_dto.ValorFixo" Label="Valor Fixo (R$)" Format="N2" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" @bind-Value="_dto.ValorMinimoVenda" Label="Valor Mínimo da Venda (R$)" Format="N2" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="_dto.Prioridade" Label="Prioridade (maior vence)" Min="1" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_dto.Ativo" Label="Regra Ativa" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar" Disabled="@_salvando">
            @(_salvando ? "Salvando..." : "Salvar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public RegraComissaoDto? RegraExistente { get; set; }

    private SalvarRegraComissaoDto _dto = new();
    private List<VendedorDto> _vendedores = new();
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        _vendedores = await Mediator.Send(new ListarVendedoresQuery(ApenasAtivos: true));

        if (RegraExistente != null)
        {
            _dto = new SalvarRegraComissaoDto
            {
                VendedorId = RegraExistente.VendedorId,
                Nome = RegraExistente.Nome,
                Tipo = RegraExistente.Tipo,
                Percentual = RegraExistente.Percentual,
                ValorFixo = RegraExistente.ValorFixo,
                ValorMinimoVenda = RegraExistente.ValorMinimoVenda,
                Prioridade = RegraExistente.Prioridade,
                Ativo = RegraExistente.Ativo
            };
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(_dto.Nome))
        {
            Snackbar.Add("Informe o nome da regra.", Severity.Warning);
            return;
        }

        _salvando = true;
        try
        {
            if (RegraExistente != null)
            {
                await Mediator.Send(new AtualizarRegraComissaoCommand(RegraExistente.Id, _dto));
                Snackbar.Add("Regra atualizada.", Severity.Success);
            }
            else
            {
                await Mediator.Send(new CriarRegraComissaoCommand(_dto));
                Snackbar.Add("Regra criada.", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar regra: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }
}
