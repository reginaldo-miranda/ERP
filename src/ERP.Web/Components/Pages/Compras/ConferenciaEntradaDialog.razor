    private void AdicionarItemAvulso()
    {
        if (_produtoSelecionado == null || _itemQtd <= 0) return;

        _itens.Add(new ItemConferenciaModel
        {
            PedidoCompraItemId = null,
            ProdutoId = _produtoSelecionado.Id,
            ProdutoCodigo = _produtoSelecionado.Codigo,
            ProdutoNome = _produtoSelecionado.Nome,
            UnidadeMedida = _produtoSelecionado.UnidadeMedida?.Sigla ?? "UN",
            ControlaLote = _produtoSelecionado.ControlaLote,
            ControlaSerie = _produtoSelecionado.ControlaSerie,
            QuantidadePedida = 0,
            Quantidade = _itemQtd,
            CustoUnitario = _itemCusto,
            DataValidadeLote = DateTime.Today.AddMonths(12),
            DataFabricacaoLote = DateTime.Today
        });

        _produtoSelecionado = null;
        _itemQtd = 1m;
        _itemCusto = 0m;
    }

    private List<(int Numero, decimal Valor, DateTime Vencimento)> CalcularProjecaoParcelas()
    {
        if (_usarDuplicatasDoXml && _parcelasDiretas.Any())
        {
            return _parcelasDiretas
                .Select((p, idx) => (int.TryParse(p.Numero, out var n) ? n : idx + 1, p.Valor, p.DataVencimento))
                .ToList();
        }

        var lista = new List<(int, decimal, DateTime)>();
        int n = _numeroParcelas > 0 ? _numeroParcelas : 1;
        int intervalo = _intervaloDias > 0 ? _intervaloDias : 30;
        decimal total = ValorTotalFinal;

        decimal valorBase = Math.Floor((total / n) * 100) / 100m;
        decimal centavos = total - (valorBase * n);

        DateTime baseDate = (_dataEmissao ?? DateTime.Today).AddDays(_diasPrimeiroVencimento);
        if (_diasPrimeiroVencimento == 0) baseDate = _dataEntrada ?? DateTime.Today;

        for (int i = 1; i <= n; i++)
        {
            decimal v = (i == 1) ? valorBase + centavos : valorBase;
            DateTime dt = (i == 1) ? baseDate : baseDate.AddDays((i - 1) * intervalo);
            lista.Add((i, v, dt));
        }

        return lista;
    }

    private async Task SalvarEntrada()
    {
        if (string.IsNullOrWhiteSpace(_numeroNotaFiscal))
        {
            Snackbar.Add("O número da Nota Fiscal é obrigatório.", Severity.Warning);
            return;
        }

        if (_fornecedorId <= 0)
        {
            Snackbar.Add("Selecione o Fornecedor.", Severity.Warning);
            return;
        }

        if (_depositoId <= 0)
        {
            Snackbar.Add("Selecione o Depósito de Destino.", Severity.Warning);
            return;
        }

        if (!_itens.Any())
        {
            Snackbar.Add("Adicione ao menos um item à conferência.", Severity.Warning);
            return;
        }

        // Validação de lotes obrigatórios
        foreach (var item in _itens)
        {
            if (item.Quantidade <= 0)
            {
                Snackbar.Add($"A quantidade do produto '{item.ProdutoNome}' deve ser maior que zero.", Severity.Warning);
                return;
            }

            if (item.ControlaLote && string.IsNullOrWhiteSpace(item.CodigoLote))
            {
                Snackbar.Add($"O produto '{item.ProdutoNome}' exige a identificação do Código do Lote.", Severity.Warning);
                return;
            }
        }

        try
        {
            _salvando = true;

            var parcelasEnvio = (_usarDuplicatasDoXml && _parcelasDiretas.Any()) ? _parcelasDiretas : null;

            var dto = new RegistrarEntradaMercadoriaDto(
                _pedidoCompraId,
                _fornecedorId,
                _depositoId,
                _numeroNotaFiscal.Trim(),
                _serieNotaFiscal?.Trim(),
                _chaveAcessoNfe?.Trim(),
                _dataEmissao ?? DateTime.Today,
                _dataEntrada ?? DateTime.Today,
                _conferenteNome,
                _valorFrete,
                _valorSeguro,
                _valorOutrasDespesas,
                _valorDesconto,
                _observacoes,
                _formaPagamentoId,
                _planoContaId,
                _centroCustoId,
                _numeroParcelas,
                _intervaloDias,
                _diasPrimeiroVencimento,
                _itens.Select(i => new RegistrarEntradaMercadoriaItemDto(
                    i.PedidoCompraItemId,
                    i.ProdutoId,
                    i.Quantidade,
                    i.CustoUnitario,
                    null,
                    i.CodigoLote?.Trim(),
                    i.DataValidadeLote,
                    i.DataFabricacaoLote,
                    i.NumerosSerieTexto?.Trim(),
                    null,
                    i.CodigoProdutoFornecedor,
                    i.DescricaoProdutoFornecedor,
                    i.UnidadeMedidaFornecedor
                )).ToList(),
                _xmlNfeOriginal,
                parcelasEnvio
            );

            var entradaId = await Mediator.Send(new RegistrarEntradaMercadoriaCommand(dto));
            Snackbar.Add($"Entrada e conferência registradas com sucesso! Estoque e Custo Médio atualizados. Títulos gerados no Contas a Pagar.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(entradaId));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao registrar entrada: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

