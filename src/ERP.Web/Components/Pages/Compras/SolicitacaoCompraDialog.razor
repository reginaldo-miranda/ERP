@using ERP.Application.Common.Interfaces
@using ERP.Application.Compras.Commands
@using ERP.Application.Compras.DTOs
@using ERP.Domain.Core.Entities.Cadastros
@using ERP.Domain.Core.Enums
@using MediatR
@using Microsoft.EntityFrameworkCore
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IApplicationDbContext Context

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">Nova Solicitação Interna de Compra</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_carregando)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_departamento" Label="Departamento / Setor Requisitante" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ex.: Produção, Manutenção, TI..." />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="PrioridadeSolicitacaoCompra" Label="Prioridade" @bind-Value="_prioridade" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="PrioridadeSolicitacaoCompra" Value="PrioridadeSolicitacaoCompra.Baixa">Baixa</MudSelectItem>
                        <MudSelectItem T="PrioridadeSolicitacaoCompra" Value="PrioridadeSolicitacaoCompra.Normal">Normal</MudSelectItem>
                        <MudSelectItem T="PrioridadeSolicitacaoCompra" Value="PrioridadeSolicitacaoCompra.Alta">Alta</MudSelectItem>
                        <MudSelectItem T="PrioridadeSolicitacaoCompra" Value="PrioridadeSolicitacaoCompra.Urgente">Urgente</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Necessidade até" @bind-Date="_dataNecessidade" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_justificativa" Label="Justificativa da Requisição" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Placeholder="Descreva por que os itens são necessários..." />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Color="Color.Primary">Adicionar Itens à Solicitação</MudText>

            <MudGrid Spacing="2" Class="align-center mb-2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="Produto" Label="Buscar Produto" Value="_produtoSelecionado" ValueChanged="OnProdutoSelecionado"
                                     SearchFunc="BuscarProdutos" ToStringFunc="@(p => p == null ? "" : $"{p.Codigo} - {p.Nome}")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ResetValueOnEmptyText="true" Placeholder="Digite código ou nome..." />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" Label="Quantidade" @bind-Value="_quantidadeItem" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.0001m" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="AdicionarItem" Disabled="_produtoSelecionado == null || _quantidadeItem <= 0" FullWidth="true">
                        Adicionar
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_itens.Any())
            {
                <MudTable Items="@_itens" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Código</MudTh>
                        <MudTh>Produto</MudTh>
                        <MudTh>UN</MudTh>
                        <MudTh class="text-right">Qtd Requisitada</MudTh>
                        <MudTh>Observação</MudTh>
                        <MudTh class="text-center">Ação</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Código">@context.ProdutoCodigo</MudTd>
                        <MudTd DataLabel="Produto" Class="font-weight-bold">@context.ProdutoNome</MudTd>
                        <MudTd DataLabel="UN">@context.UnidadeMedida</MudTd>
                        <MudTd DataLabel="Qtd" Class="text-right font-weight-bold">@context.Quantidade.ToString("N2")</MudTd>
                        <MudTd DataLabel="Obs">
                            <MudTextField @bind-Value="context.Observacao" Variant="Variant.Text" Margin="Margin.Dense" Placeholder="Obs do item..." />
                        </MudTd>
                        <MudTd Class="text-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoverItem(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Nenhum item adicionado ainda. Adicione pelo menos um produto acima.</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="Salvar" Disabled="_carregando || !_itens.Any()">
            Enviar Solicitação
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _carregando = true;
    private string? _departamento;
    private PrioridadeSolicitacaoCompra _prioridade = PrioridadeSolicitacaoCompra.Normal;
    private DateTime? _dataNecessidade = DateTime.UtcNow.Date.AddDays(7);
    private string? _justificativa;
    private string? _observacoes;

    private List<Produto> _produtos = new();
    private Produto? _produtoSelecionado;
    private decimal _quantidadeItem = 1m;

    private class ItemLinha
    {
        public int ProdutoId { get; set; }
        public string ProdutoCodigo { get; set; } = string.Empty;
        public string ProdutoNome { get; set; } = string.Empty;
        public string UnidadeMedida { get; set; } = string.Empty;
        public decimal Quantidade { get; set; }
        public string? Observacao { get; set; }
    }

    private List<ItemLinha> _itens = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _carregando = true;
            _produtos = await Context.Produtos.AsNoTracking()
                .Include(p => p.UnidadeMedida)
                .Where(p => p.Ativo)
                .OrderBy(p => p.Nome)
                .ToListAsync();
        }
        finally
        {
            _carregando = false;
        }
    }

    private Task<IEnumerable<Produto>> BuscarProdutos(string text, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<Produto>>(_produtos.Take(20));

        var filtrados = _produtos
            .Where(p => p.Nome.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                        p.Codigo.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Take(20);

        return Task.FromResult(filtrados);
    }

    private void OnProdutoSelecionado(Produto? prod)
    {
        _produtoSelecionado = prod;
    }

    private void AdicionarItem()
    {
        if (_produtoSelecionado == null || _quantidadeItem <= 0) return;

        var existente = _itens.FirstOrDefault(i => i.ProdutoId == _produtoSelecionado.Id);
        if (existente != null)
        {
            existente.Quantidade += _quantidadeItem;
        }
        else
        {
            _itens.Add(new ItemLinha
            {
                ProdutoId = _produtoSelecionado.Id,
                ProdutoCodigo = _produtoSelecionado.Codigo,
                ProdutoNome = _produtoSelecionado.Nome,
                UnidadeMedida = _produtoSelecionado.UnidadeMedida?.Sigla ?? "UN",
                Quantidade = _quantidadeItem
            });
        }

        _produtoSelecionado = null;
        _quantidadeItem = 1m;
    }

    private void RemoverItem(ItemLinha item)
    {
        _itens.Remove(item);
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        if (!_itens.Any())
        {
            Snackbar.Add("Adicione ao menos um item à solicitação.", Severity.Warning);
            return;
        }

        try
        {
            var dto = new CriarSolicitacaoCompraDto(
                _departamento,
                _dataNecessidade,
                _prioridade,
                _justificativa,
                _observacoes,
                _itens.Select(i => new CriarSolicitacaoCompraItemDto(i.ProdutoId, i.Quantidade, i.Observacao)).ToList()
            );

            var id = await Mediator.Send(new CriarSolicitacaoCompraCommand(dto));
            Snackbar.Add("Solicitação de compra criada com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(id));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao criar solicitação: {ex.Message}", Severity.Error);
        }
    }
}
