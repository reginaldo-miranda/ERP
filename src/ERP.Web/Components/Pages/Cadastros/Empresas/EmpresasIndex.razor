@page "/cadastros/empresas"
@using ERP.Application.Empresas.Commands.DesativarEmpresa
@using ERP.Application.Empresas.DTOs
@using ERP.Application.Empresas.Queries.GetEmpresas
@using ERP.Web.Services
@using MediatR
@inject IMediator Mediator
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CustomAuthStateProvider AuthState

<PageTitle>Gestão de Empresas — ERP</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
            Gestão de Empresas
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Cadastre e gerencie as unidades de negócio do sistema ERP Multi-Empresa.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.AddBusiness" 
               OnClick="AbrirNovaEmpresa">
        Nova Empresa
    </MudButton>
</div>

<MudCard Elevation="2">
    <MudCardContent Class="pa-0">
        <MudTable Items="@_empresas" 
                  Dense="true" 
                  Hover="true" 
                  Loading="@_carregando" 
                  Filter="new Func<EmpresaDto,bool>(FiltroRapido)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Empresas Cadastradas (@_empresas.Count)</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_busca" 
                              Placeholder="Buscar por Razão Social, Nome Fantasia ou CNPJ..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              IconSize="Size.Medium" 
                              Class="mt-0" 
                              Clearable="true" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Razão Social / Nome Fantasia</MudTh>
                <MudTh>CNPJ</MudTh>
                <MudTh>Cidade / UF</MudTh>
                <MudTh>Regime</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Razão Social">
                    <div class="d-flex align-center">
                        @if (context.Id == AuthState.EmpresaAtivaId)
                        {
                            <MudTooltip Text="Empresa Atualmente Selecionada">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                            </MudTooltip>
                        }
                        <div>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.RazaoSocial</MudText>
                            @if (!string.IsNullOrEmpty(context.NomeFantasia))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NomeFantasia</MudText>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="CNPJ">@context.Cnpj</MudTd>
                <MudTd DataLabel="Cidade / UF">
                    @(string.IsNullOrEmpty(context.Cidade) ? "—" : $"{context.Cidade}/{context.Uf}")
                </MudTd>
                <MudTd DataLabel="Regime">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                        @context.RegimeTributario
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.Ativo ? Color.Success : Color.Default)">
                        @(context.Ativo ? "Ativa" : "Inativa")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    @if (context.Id != AuthState.EmpresaAtivaId && context.Ativo)
                    {
                        <MudTooltip Text="Definir como Empresa Ativa">
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircleOutline" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => DefinirAtiva(context))" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="Editar Empresa">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       OnClick="@(() => AbrirEditarEmpresa(context))" />
                    </MudTooltip>
                    <MudTooltip Text="@(context.Ativo ? "Desativar Empresa" : "Reativar Empresa")">
                        <MudIconButton Icon="@(context.Ativo ? Icons.Material.Filled.Block : Icons.Material.Filled.Check)" 
                                       Color="@(context.Ativo ? Color.Error : Color.Success)" 
                                       Size="Size.Small" 
                                       OnClick="@(() => AlternarStatus(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Linhas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {
    private List<EmpresaDto> _empresas = new();
    private bool _carregando = true;
    private string _busca = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEmpresas();
    }

    private async Task CarregarEmpresas()
    {
        _carregando = true;
        try
        {
            _empresas = await Mediator.Send(new GetEmpresasQuery(ApenasAtivas: false));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar empresas: {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    private bool FiltroRapido(EmpresaDto e)
    {
        if (string.IsNullOrWhiteSpace(_busca)) return true;
        if (e.RazaoSocial.Contains(_busca, StringComparison.OrdinalIgnoreCase)) return true;
        if (e.NomeFantasia?.Contains(_busca, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (e.Cnpj.Contains(_busca, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task AbrirNovaEmpresa()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EmpresaDialog>("Nova Empresa", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CarregarEmpresas();
        }
    }

    private async Task AbrirEditarEmpresa(EmpresaDto empresa)
    {
        var parameters = new DialogParameters<EmpresaDialog> { { x => x.Empresa, empresa } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EmpresaDialog>("Editar Empresa", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CarregarEmpresas();
        }
    }

    private async Task AlternarStatus(EmpresaDto empresa)
    {
        var result = await Mediator.Send(new DesativarEmpresaCommand(empresa.Id));
        if (result.Sucesso)
        {
            Snackbar.Add(empresa.Ativo ? "Empresa desativada com sucesso!" : "Empresa ativada com sucesso!", Severity.Success);
            await CarregarEmpresas();
        }
        else
        {
            Snackbar.Add(result.Erros.FirstOrDefault() ?? "Erro ao alterar status da empresa.", Severity.Error);
        }
    }

    private async Task DefinirAtiva(EmpresaDto empresa)
    {
        var nome = empresa.NomeFantasia ?? empresa.RazaoSocial;
        await AuthState.TrocarEmpresaAsync(empresa.Id, nome);
        Snackbar.Add($"Empresa ativa alterada para: {nome}", Severity.Success);
        StateHasChanged();
    }
}
