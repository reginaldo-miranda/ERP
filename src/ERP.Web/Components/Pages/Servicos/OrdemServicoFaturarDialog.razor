@using ERP.Application.Common.Interfaces
@using ERP.Application.Servicos.Commands
@using ERP.Application.Servicos.DTOs
@using ERP.Application.Servicos.Queries
@using ERP.Domain.Core.Entities.Financeiro
@using MediatR
@using Microsoft.EntityFrameworkCore
@inject IMediator Mediator
@inject IApplicationDbContext Context
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Success" Class="mr-2" />
            <MudText Typo="Typo.h6">Faturar Ordem de Serviço</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_carregando)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else if (_os != null)
        {
            <!-- Resumo da OS -->
            <MudCard Outlined="true" Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">OS:</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@_os.Numero</MudText>
                </div>
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">Cliente:</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@_os.ClienteNome</MudText>
                </div>
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">Equipamento:</MudText>
                    <MudText Typo="Typo.body2">@_os.Equipamento</MudText>
                </div>
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">Mão de Obra:</MudText>
                    <MudText Typo="Typo.body2">@_os.ValorServicos.ToString("C2")</MudText>
                </div>
                <div class="d-flex justify-space-between mb-1">
                    <MudText Typo="Typo.body2">Peças Utilizadas:</MudText>
                    <MudText Typo="Typo.body2">@_os.ValorPecas.ToString("C2")</MudText>
                </div>
                @if (_os.ValorDesconto > 0)
                {
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Error">Desconto:</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Error">-@_os.ValorDesconto.ToString("C2")</MudText>
                    </div>
                }
                <div class="d-flex justify-space-between align-center mt-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Success">Total a Faturar:</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Success">@_os.ValorTotal.ToString("C2")</MudText>
                </div>
            </MudCard>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Ao faturar, a baixa das peças no estoque e os lançamentos no <b>Contas a Receber</b> serão executados automaticamente.
            </MudAlert>

            <!-- Condições de Pagamento -->
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Forma de Pagamento *" @bind-Value="_formaPagamentoId" Required="true" Dense="true" Variant="Variant.Outlined">
                        @foreach (var fp in _formasPagamento)
                        {
                            <MudSelectItem Value="@fp.Id">@fp.Nome</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="6">
                    <MudNumericField @bind-Value="_numeroParcelas" Label="Parcelas" Min="1" Max="24" Dense="true" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="6">
                    <MudNumericField @bind-Value="_diasPrimeiroVencimento" Label="1º Vencimento (Dias)" Min="0" Max="180" Dense="true" Variant="Variant.Outlined" HelperText="0 = Hoje / À Vista" />
                </MudItem>

                @if (_numeroParcelas > 1)
                {
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="_intervaloDias" Label="Intervalo entre Parcelas (Dias)" Min="1" Max="90" Dense="true" Variant="Variant.Outlined" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField @bind-Value="_observacoes" Label="Observações do Faturamento" Dense="true" Variant="Variant.Outlined" Lines="2" Placeholder="Detalhes de pagamento ou recibo..." />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Voltar</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="ConfirmarFaturamento" Disabled="@_salvando">
            @if (_salvando)
            {
                <MudProgressCircular Class="mr-1" Size="Size.Small" Indeterminate="true" />
                <span>Processando...</span>
            }
            else
            {
                <span>Confirmar &amp; Faturar</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int OrdemServicoId { get; set; }

    private bool _carregando = true;
    private bool _salvando = false;
    private OrdemServicoDetalhesDto? _os;
    private List<FormaPagamento> _formasPagamento = new();

    private int _formaPagamentoId = 0;
    private int _numeroParcelas = 1;
    private int _intervaloDias = 30;
    private int _diasPrimeiroVencimento = 0;
    private string? _observacoes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _os = await Mediator.Send(new GetOrdemServicoByIdQuery(OrdemServicoId));
            _formasPagamento = await Context.FormasPagamento.AsNoTracking().Where(f => f.Ativa).OrderBy(f => f.Nome).ToListAsync();

            if (_os != null)
            {
                if (_os.FormaPagamentoId.HasValue && _formasPagamento.Any(f => f.Id == _os.FormaPagamentoId.Value))
                {
                    _formaPagamentoId = _os.FormaPagamentoId.Value;
                }
                else if (_formasPagamento.Any())
                {
                    _formaPagamentoId = _formasPagamento.First().Id;
                }

                _numeroParcelas = Math.Max(1, _os.NumeroParcelas);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar dados de faturamento: {ex.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task ConfirmarFaturamento()
    {
        if (_formaPagamentoId <= 0)
        {
            Snackbar.Add("Selecione a forma de pagamento para faturar a OS.", Severity.Warning);
            return;
        }

        _salvando = true;
        try
        {
            var dto = new FaturarOrdemServicoDto(
                OrdemServicoId,
                _formaPagamentoId,
                _numeroParcelas,
                _intervaloDias,
                _diasPrimeiroVencimento,
                _observacoes
            );

            var ok = await Mediator.Send(new FaturarOrdemServicoCommand(dto));
            if (ok)
            {
                Snackbar.Add("Ordem de Serviço faturada com sucesso! Contas a Receber e baixas de estoque foram geradas.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao faturar OS: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
