@using ERP.Application.Contratos.Commands
@using ERP.Application.Contratos.DTOs
@using MediatR
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Class="mr-2" />
            <MudText Typo="Typo.h6">Reajuste &amp; Renovação (@Contrato.Numero)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Valor atual: <b>@Contrato.ValorMensal.ToString("C2")</b>
            → Novo valor estimado: <b style="color: var(--mud-palette-primary);">@ValorEstimado.ToString("C2")</b>
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_percentual" Label="Percentual de Reajuste (%)" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_indice" Label="Índice (IPCA / IGP-M / etc.)" Variant="Variant.Outlined" Dense="true" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_renovarVigencia" Label="Também renovar a vigência do contrato" Color="Color.Primary" />
            </MudItem>
            @if (_renovarVigencia)
            {
                <MudItem xs="12">
                    <MudNumericField T="int" @bind-Value="_mesesAdicionais" Label="Meses adicionais de vigência" Min="1" Max="120" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField @bind-Value="_observacao" Label="Observação" Lines="2" Variant="Variant.Outlined" Dense="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aplicar" Disabled="@_salvando">
            @(_salvando ? "Aplicando..." : "Aplicar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ContratoRecorrenteDto Contrato { get; set; } = null!;

    private decimal _percentual;
    private string? _indice;
    private bool _renovarVigencia;
    private int _mesesAdicionais = 12;
    private string? _observacao;
    private bool _salvando;

    private decimal ValorEstimado => Math.Round(Contrato.ValorMensal * (1m + _percentual / 100m), 2);

    protected override void OnInitialized()
    {
        _percentual = Contrato.PercentualReajustePadrao;
        _indice = Contrato.IndiceReajuste ?? "IPCA";
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Aplicar()
    {
        _salvando = true;
        try
        {
            if (_renovarVigencia)
            {
                await Mediator.Send(new RenovarContratoCommand(Contrato.Id, _mesesAdicionais, _percentual));
                Snackbar.Add("Contrato renovado e reajustado!", Severity.Success);
            }
            else
            {
                await Mediator.Send(new AplicarReajusteContratoCommand(Contrato.Id, _percentual, _indice, _observacao));
                Snackbar.Add("Reajuste aplicado com sucesso!", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }
}
