@using ERP.Application.Estoque.Commands
@using ERP.Application.Estoque.DTOs
@using ERP.Application.Estoque.Queries
@using MediatR
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.QrCode" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Cadastrar Novo Lote</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_carregando)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect T="int" Label="Produto *" @bind-Value="_produtoId" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var p in _produtos)
                        {
                            <MudSelectItem Value="@p.ProdutoId">@p.ProdutoCodigo - @p.ProdutoNome</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Depósito *" @bind-Value="_depositoId" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var dep in _depositos)
                        {
                            <MudSelectItem Value="@dep.Id">@dep.Nome</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Código do Lote *" @bind-Value="_codigoLote"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ex: LOT-2026-001" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data de Fabricação" @bind-Date="_dataFabricacao"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" DateFormat="dd/MM/yyyy" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data de Validade *" @bind-Date="_dataValidade"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" DateFormat="dd/MM/yyyy" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Label="Quantidade Inicial *" @bind-Value="_quantidade"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.0001m" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" Label="Custo Unitário (R$)" @bind-Value="_custoUnitario"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Format="N2" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Observações" @bind-Value="_observacoes"
                                  Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Salvar"
                   Disabled="@(_salvando || _produtoId == 0 || _depositoId == 0 || string.IsNullOrWhiteSpace(_codigoLote) || !_dataValidade.HasValue || _quantidade <= 0)">
            @if (_salvando)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Salvando...</MudText>
            }
            else
            {
                <span>Salvar Lote</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _carregando = true;
    private bool _salvando = false;

    private List<DepositoDto> _depositos = new();
    private List<PosicaoEstoqueDto> _produtos = new();

    private int _produtoId;
    private int _depositoId;
    private string _codigoLote = string.Empty;
    private DateTime? _dataFabricacao = DateTime.UtcNow.Date;
    private DateTime? _dataValidade = DateTime.UtcNow.Date.AddMonths(12);
    private decimal _quantidade = 100;
    private decimal _custoUnitario = 0;
    private string? _observacoes;

    protected override async Task OnInitializedAsync()
    {
        _carregando = true;
        try
        {
            _depositos = await Mediator.Send(new GetDepositosQuery(SomenteAtivos: true));
            if (_depositos.Any())
            {
                var padrao = _depositos.FirstOrDefault(d => d.Padrao) ?? _depositos.First();
                _depositoId = padrao.Id;
            }

            _produtos = await Mediator.Send(new GetPosicaoEstoqueQuery());
            if (_produtos.Any())
            {
                _produtoId = _produtos.First().ProdutoId;
            }
        }
        finally
        {
            _carregando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(_codigoLote))
        {
            Snackbar.Add("Informe o código do lote.", Severity.Warning);
            return;
        }

        if (!_dataValidade.HasValue)
        {
            Snackbar.Add("Informe a data de validade.", Severity.Warning);
            return;
        }

        _salvando = true;
        try
        {
            var dto = new CriarLoteDto(
                _produtoId,
                _depositoId,
                _codigoLote,
                _dataFabricacao,
                _dataValidade.Value,
                _quantidade,
                _custoUnitario,
                _observacoes
            );

            await Mediator.Send(new CriarLoteCommand(dto));
            Snackbar.Add("Lote cadastrado com sucesso!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao cadastrar lote: {ex.Message}", Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }
}
