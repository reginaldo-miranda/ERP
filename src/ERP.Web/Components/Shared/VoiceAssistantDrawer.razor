@using ERP.Application.Vendas.Voice
@using MudBlazor
@inject IVoiceAssistantService VoiceService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IAsyncDisposable

<!-- Botão Flutuante (FAB) de Microfone no Canto Inferior Direito -->
<div style="position: fixed; bottom: 28px; right: 28px; z-index: 1300;">
    <MudTooltip Text="Assistente de Voz / Copilot ERP">
        <MudBadge Dot="true" Color="@(_estaOuvindo ? Color.Error : Color.Success)" Overlap="true" Visible="true">
            <MudFab Color="@(_estaOuvindo ? Color.Error : Color.Primary)" 
                    StartIcon="@(_estaOuvindo ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicNone)" 
                    Size="Size.Large" 
                    OnClick="AlternarDrawer" 
                    Class="@(_estaOuvindo ? "pulse-animation" : "")" />
        </MudBadge>
    </MudTooltip>
</div>

<!-- Drawer Lateral do Assistente -->
<MudDrawer @bind-Open="_drawerAberto" Anchor="Anchor.Right" Elevation="5" Variant="DrawerVariant.Temporary" Width="460px">
    <div class="d-flex flex-column h-100" style="background: var(--mud-palette-background);">
        
        <!-- Header do Drawer -->
        <div class="pa-4 d-flex justify-space-between align-center border-b" style="background: var(--mud-palette-surface);">
            <div class="d-flex align-center gap-2">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Copilot por Voz</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pedidos de Venda &amp; NF-e</MudText>
                </div>
            </div>
            <div class="d-flex align-center gap-1">
                <MudTooltip Text="@(_falarRespostas ? "Desativar áudio do assistente" : "Ativar áudio do assistente")">
                    <MudIconButton Icon="@(_falarRespostas ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)" 
                                   Color="@(_falarRespostas ? Color.Primary : Color.Default)" 
                                   Size="Size.Small" 
                                   OnClick="@(() => _falarRespostas = !_falarRespostas)" />
                </MudTooltip>
                <MudTooltip Text="Novo Pedido / Limpar">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="ReiniciarSessao" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _drawerAberto = false)" />
            </div>
        </div>

        <!-- Conteúdo Rolável -->
        <div class="flex-grow-1 overflow-y-auto pa-4">
            
            <!-- Controle Principal de Microfone -->
            <MudPaper Class="pa-4 mb-4 text-center d-flex flex-column align-center justify-center" Elevation="2" Style="border-radius: 16px;">
                <MudIconButton Icon="@(_estaOuvindo ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicNone)" 
                               Color="@(_estaOuvindo ? Color.Error : Color.Primary)" 
                               Size="Size.Large" 
                               Variant="Variant.Filled" 
                               Class="@(_estaOuvindo ? "pulse-button mb-2" : "mb-2")" 
                               Style="width: 72px; height: 72px;"
                               OnClick="AlternarMicrofone" />

                <MudText Typo="Typo.body2" Class="font-weight-bold">
                    @(_estaOuvindo ? "Ouvindo... pode falar" : "Toque no microfone para falar")
                </MudText>

                @if (!string.IsNullOrWhiteSpace(_textoInterim))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 font-italic">
                        "@_textoInterim"
                    </MudText>
                }
                else if (_estaOuvindo)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Ex.: "faça um pedido para José Maria" ou "10 sacos de cimento"
                    </MudText>
                }
            </MudPaper>

            <!-- ========================================== -->
            <!-- ETAPA: CLIENTE NÃO ENCONTRADO / CADASTRO -->
            <!-- ========================================== -->
            @if (_mostrarFormCliente)
            {
                <MudPaper Elevation="3" Class="pa-4 mb-4 border-l-4" Style="border-left-color: var(--mud-palette-warning) !important;">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" Class="mr-1" />
                            Cadastrar Novo Cliente
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _mostrarFormCliente = false)" />
                    </div>
                    <MudTextField @bind-Value="_novoClienteNome" Label="Nome do Cliente" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    <MudTextField @bind-Value="_novoClienteTelefone" Label="Telefone / WhatsApp" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                    <MudTextField @bind-Value="_novoClienteCpf" Label="CPF" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    <div class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => _mostrarFormCliente = false)">Cancelar</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SalvarNovoCliente" Disabled="@string.IsNullOrWhiteSpace(_novoClienteNome)">Salvar e Continuar</MudButton>
                    </div>
                </MudPaper>
            }
            else if (_estado.Status == VoiceSessionStatus.AguardandoCliente && !string.IsNullOrWhiteSpace(_estado.TermoClienteNaoEncontrado))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    <div><b>Cliente não encontrado:</b> "@_estado.TermoClienteNaoEncontrado"</div>
                    <MudText Typo="Typo.caption" Class="mt-1 d-block">Diga outro nome no microfone ou faça o cadastro rápido:</MudText>
                    <div class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirFormCliente">
                            Cadastrar Cliente "@_estado.TermoClienteNaoEncontrado"
                        </MudButton>
                    </div>
                </MudAlert>
            }
            else if (_estado.Status == VoiceSessionStatus.AguardandoCliente && _estado.CandidatosClientes.Any())
            {
                <MudPaper Elevation="3" Class="pa-3 mb-4 border-l-4" Style="border-left-color: var(--mud-palette-info) !important;">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
                        Selecione o Cliente (diga o número ou clique):
                    </MudText>
                    <div class="d-flex flex-column gap-2">
                        @for (int i = 0; i < _estado.CandidatosClientes.Count; i++)
                        {
                            var cli = _estado.CandidatosClientes[i];
                            int idx = i;
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="justify-start text-left pa-2" OnClick="@(() => SelecionarClienteManual(cli.Id))">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mr-2">@(idx + 1)</MudChip>
                                <div>
                                    <div class="font-weight-bold">@cli.Nome</div>
                                    @if (!string.IsNullOrWhiteSpace(cli.Telefone))
                                    {
                                        <div class="text-muted" style="font-size: 0.75rem;">Tel: @cli.Telefone</div>
                                    }
                                </div>
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }

            <!-- ========================================== -->
            <!-- ETAPA: ESCOLHA DE PRODUTOS ENCONTRADOS     -->
            <!-- ========================================== -->
            @if (_estado.Status == VoiceSessionStatus.AguardandoEscolhaProduto && _estado.CandidatosProdutos.Any())
            {
                <MudPaper Elevation="3" Class="pa-3 mb-4 border-l-4" Style="border-left-color: var(--mud-palette-secondary) !important;">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                            <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" Class="mr-1" />
                            Qual produto você deseja? (@_estado.CandidatosProdutos.Count opções)
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="CancelarEscolhaProduto">Cancelar</MudButton>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                        Quantidade pendente: <b>@_estado.QuantidadePendente</b>. Diga o número da opção ou clique:
                    </MudText>
                    <div class="d-flex flex-column gap-2">
                        @for (int i = 0; i < _estado.CandidatosProdutos.Count; i++)
                        {
                            var prod = _estado.CandidatosProdutos[i];
                            int idx = i;
                            <MudButton Variant="Variant.Filled" Color="Color.Surface" Elevation="1" FullWidth="true" Class="justify-space-between pa-2 border" OnClick="@(() => SelecionarProdutoManual(prod.Id))">
                                <div class="d-flex align-center">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mr-2 font-weight-bold">@(idx + 1)</MudChip>
                                    <div class="text-left">
                                        <div class="font-weight-bold">@prod.Nome</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">Cód: @prod.Codigo | @prod.UnidadeMedida</div>
                                    </div>
                                </div>
                                <div class="font-weight-bold text-success ml-2">
                                    @prod.PrecoVenda.ToString("C2")
                                </div>
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }

            @if (!string.IsNullOrWhiteSpace(_estado.TermoProdutoNaoEncontrado))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                    <b>Produto não encontrado:</b> "@_estado.TermoProdutoNaoEncontrado".
                    <div style="font-size: 0.8rem;">Diga o nome novamente ou consulte os produtos cadastrados.</div>
                </MudAlert>
            }

            <!-- ========================================== -->
            <!-- CARD DE RASCUNHO DO PEDIDO EM TEMPO REAL   -->
            <!-- ========================================== -->
            @if (_estado.Status != VoiceSessionStatus.AguardandoComando)
            {
                <MudCard Elevation="3" Class="mb-4 border-l-4" Style="border-left-color: var(--mud-palette-primary) !important;">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderContent>
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-1" />
                                    @(_estado.PedidoCriadoNumero != null ? _estado.PedidoCriadoNumero : "Rascunho de Pedido")
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@ObterCorStatusSessao(_estado.Status)">
                                    @_estado.Status
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Cliente: <b>@(_estado.ClienteNome ?? "Não selecionado")</b> | Pagto: <b>@_estado.CondicaoPagamento</b>
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="pt-0">
                        @if (_estado.Itens.Any())
                        {
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                <thead>
                                    <tr>
                                        <th style="width: 100px;">Qtd</th>
                                        <th>Produto</th>
                                        <th style="text-align: right;">Total</th>
                                        <th style="width: 32px; text-align: center;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _estado.Itens)
                                    {
                                        <tr>
                                            <td style="white-space: nowrap;">
                                                <div class="d-flex align-center gap-1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" 
                                                                   Size="Size.Small" 
                                                                   Style="width: 20px; height: 20px; padding: 0;" 
                                                                   OnClick="@(() => AlterarQtdItem(item.ProdutoId, -1))" />
                                                    <span><b>@item.Quantidade</b></span>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Add" 
                                                                   Size="Size.Small" 
                                                                   Style="width: 20px; height: 20px; padding: 0;" 
                                                                   OnClick="@(() => AlterarQtdItem(item.ProdutoId, 1))" />
                                                </div>
                                            </td>
                                            <td>
                                                <div><b>@item.ProdutoNome</b></div>
                                                <div class="text-muted" style="font-size: 0.7rem;">@item.ValorUnitario.ToString("C2") un</div>
                                            </td>
                                            <td style="text-align: right; font-weight: bold;">@item.ValorTotal.ToString("C2")</td>
                                            <td style="text-align: center;">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                               Color="Color.Error" 
                                                               Size="Size.Small" 
                                                               Style="width: 24px; height: 24px; padding: 0;" 
                                                               OnClick="@(() => RemoverItem(item.ProdutoId))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>

                            <div class="d-flex justify-space-between align-center mt-3 pt-2 border-t">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Total do Pedido:</MudText>
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Success">@_estado.ValorTotal.ToString("C2")</MudText>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Nenhum item adicionado ainda. Diga o nome do produto e a quantidade.</MudText>
                            </div>
                        }

                        <!-- Ações Rápidas por Botão de Acordo com o Estado -->
                        @if ((_estado.Status == VoiceSessionStatus.CriandoPedidoAguardandoItens || _estado.Status == VoiceSessionStatus.AguardandoEscolhaProduto) && _estado.Itens.Any())
                        {
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       FullWidth="true" 
                                       Class="mt-3" 
                                       StartIcon="@Icons.Material.Filled.Check" 
                                       OnClick="FinalizarPedidoManualmente">
                                Finalizar Pedido (ou diga "Finalizar")
                            </MudButton>
                        }
                        else if (_estado.Status == VoiceSessionStatus.PedidoConcluidoAguardandoNfe)
                        {
                            <div class="mt-3 pa-3 rounded" style="background: rgba(var(--mud-palette-success-rgb), 0.1);">
                                <MudText Typo="Typo.body2" Class="font-weight-bold text-success mb-2">
                                    Pedido Gerado! Deseja emitir a NF-e agora?
                                </MudText>
                                <div class="d-flex gap-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="EmitirNfeManualmente">
                                        Sim, Emitir NF-e
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="RecusarNfe">
                                        Não
                                    </MudButton>
                                </div>
                            </div>
                        }
                        else if (_estado.Status == VoiceSessionStatus.NfeEmitida)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                                <b>NF-e Autorizada com sucesso!</b>
                                <div class="mt-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf" Href="@_linkDanfe" Target="_blank">
                                        Visualizar DANFE
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <!-- Histórico da Conversa -->
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 font-weight-bold text-uppercase d-block">Histórico da Conversa</MudText>
            <div class="d-flex flex-column gap-2 mb-4">
                @foreach (var msg in _mensagens)
                {
                    <div class="@(msg.Remetente == "Usuario" ? "align-self-end" : "align-self-start")" style="max-width: 85%;">
                        <MudPaper Class="@(msg.Remetente == "Usuario" ? "pa-3 mud-theme-primary" : "pa-3")" 
                                  Elevation="1" 
                                  Style="@(msg.Remetente == "Usuario" ? "border-radius: 12px 12px 2px 12px;" : "border-radius: 12px 12px 12px 2px;")">
                            <MudText Typo="Typo.caption" Class="d-block font-weight-bold" Style="@(msg.Remetente == "Usuario" ? "opacity: 0.85;" : "color: var(--mud-palette-primary);")">
                                @msg.Remetente • @msg.Horario.ToString("HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2">@msg.Texto</MudText>
                        </MudPaper>
                    </div>
                }
            </div>

        </div>

        <!-- Rodapé do Drawer com Input Manual de Texto -->
        <div class="pa-3 border-t d-flex gap-2" style="background: var(--mud-palette-surface);">
            <MudTextField @bind-Value="_textoDigitado" 
                          Placeholder="Ou digite o comando aqui..." 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Immediate="true"
                          OnKeyDown="@(async (e) => { if (e.Key == "Enter") await EnviarTextoManual(); })" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" OnClick="EnviarTextoManual" Disabled="@string.IsNullOrWhiteSpace(_textoDigitado)" />
        </div>

    </div>
</MudDrawer>

<style>
    .pulse-animation {
        animation: pulse-fab 1.5s infinite;
    }
    @@keyframes pulse-fab {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 14px rgba(239, 68, 68, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .pulse-button {
        animation: pulse-ring 1.5s infinite;
    }
    @@keyframes pulse-ring {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
</style>

@code {
    private bool _drawerAberto;
    private bool _estaOuvindo;
    private bool _falarRespostas = true;
    private string _textoInterim = string.Empty;
    private string _textoDigitado = string.Empty;
    private string? _linkDanfe;

    // Cadastro Rápido de Cliente
    private bool _mostrarFormCliente;
    private string _novoClienteNome = string.Empty;
    private string _novoClienteTelefone = string.Empty;
    private string _novoClienteCpf = string.Empty;

    private VoiceSessionState _estado = new();
    private List<VoiceChatMessageDto> _mensagens = new();
    private DotNetObjectReference<VoiceAssistantDrawer>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Assistente",
            Texto = "Olá! Sou o seu Copilot de Voz do ERP. Diga algo como: 'ERP, faça um pedido de venda' para começarmos."
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("voiceAssistant.init", _dotNetRef);
        }
    }

    private async Task AlternarDrawer()
    {
        _drawerAberto = !_drawerAberto;
        if (_drawerAberto && !_estaOuvindo)
        {
            await IniciarEscuta();
        }
    }

    private async Task AlternarMicrofone()
    {
        if (_estaOuvindo)
            await PararEscuta();
        else
            await IniciarEscuta();
    }

    private async Task IniciarEscuta()
    {
        _textoInterim = string.Empty;
        await JS.InvokeVoidAsync("voiceAssistant.startListening");
    }

    private async Task PararEscuta()
    {
        await JS.InvokeVoidAsync("voiceAssistant.stopListening");
    }

    [JSInvokable]
    public void OnSpeechStateChanged(bool ouvindo)
    {
        _estaOuvindo = ouvindo;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInterimTranscript(string texto)
    {
        _textoInterim = texto;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnFinalTranscript(string textoFinal)
    {
        _textoInterim = string.Empty;
        if (!string.IsNullOrWhiteSpace(textoFinal))
        {
            await ProcessarComando(textoFinal);
        }
    }

    [JSInvokable]
    public void OnSpeechError(string erro)
    {
        _estaOuvindo = false;
        Snackbar.Add("Microfone: " + erro, Severity.Warning);
        StateHasChanged();
    }

    private async Task EnviarTextoManual()
    {
        if (string.IsNullOrWhiteSpace(_textoDigitado)) return;
        var texto = _textoDigitado.Trim();
        _textoDigitado = string.Empty;
        await ProcessarComando(texto);
    }

    private async Task ProcessarComando(string comando)
    {
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Usuario",
            Texto = comando
        });
        StateHasChanged();

        try
        {
            var resultado = await VoiceService.ProcessarComandoVozAsync(_estado, comando);
            _estado = resultado.Estado;
            _linkDanfe = resultado.LinkDanfe;

            _mensagens.Add(new VoiceChatMessageDto
            {
                Remetente = "Assistente",
                Texto = resultado.MensagemResposta
            });

            if (_falarRespostas && resultado.DeveFalar && !string.IsNullOrWhiteSpace(resultado.MensagemResposta))
            {
                await JS.InvokeVoidAsync("voiceAssistant.speak", resultado.MensagemResposta);
            }
        }
        catch (Exception ex)
        {
            _mensagens.Add(new VoiceChatMessageDto
            {
                Remetente = "Assistente",
                Texto = "Desculpe, ocorreu um erro ao processar seu comando: " + ex.Message,
                EhErro = true
            });
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Ações Manuais da Interface
    private async Task SelecionarClienteManual(int clienteId)
    {
        var res = await VoiceService.SelecionarClienteCandidatoAsync(_estado, clienteId);
        _estado = res.Estado;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = res.MensagemResposta });
        if (_falarRespostas && res.DeveFalar) await JS.InvokeVoidAsync("voiceAssistant.speak", res.MensagemResposta);
        StateHasChanged();
    }

    private void AbrirFormCliente()
    {
        _novoClienteNome = _estado.TermoClienteNaoEncontrado ?? string.Empty;
        _novoClienteTelefone = string.Empty;
        _novoClienteCpf = string.Empty;
        _mostrarFormCliente = true;
    }

    private async Task SalvarNovoCliente()
    {
        if (string.IsNullOrWhiteSpace(_novoClienteNome)) return;

        var res = await VoiceService.CadastrarClienteRapidoAsync(_estado, _novoClienteNome, _novoClienteTelefone, _novoClienteCpf);
        _estado = res.Estado;
        _mostrarFormCliente = false;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = res.MensagemResposta });
        if (_falarRespostas && res.DeveFalar) await JS.InvokeVoidAsync("voiceAssistant.speak", res.MensagemResposta);
        StateHasChanged();
    }

    private async Task SelecionarProdutoManual(int produtoId)
    {
        var res = await VoiceService.SelecionarProdutoCandidatoAsync(_estado, produtoId, _estado.QuantidadePendente);
        _estado = res.Estado;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = res.MensagemResposta });
        if (_falarRespostas && res.DeveFalar) await JS.InvokeVoidAsync("voiceAssistant.speak", res.MensagemResposta);
        StateHasChanged();
    }

    private void CancelarEscolhaProduto()
    {
        _estado.Status = VoiceSessionStatus.CriandoPedidoAguardandoItens;
        _estado.CandidatosProdutos.Clear();
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = "Seleção de produto cancelada." });
        StateHasChanged();
    }

    private async Task RemoverItem(int produtoId)
    {
        var res = await VoiceService.RemoverItemPedidoAsync(_estado, produtoId);
        _estado = res.Estado;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = res.MensagemResposta });
        StateHasChanged();
    }

    private async Task AlterarQtdItem(int produtoId, decimal delta)
    {
        var item = _estado.Itens.FirstOrDefault(i => i.ProdutoId == produtoId);
        if (item != null)
        {
            decimal novaQtd = item.Quantidade + delta;
            var res = await VoiceService.AlterarQuantidadeItemAsync(_estado, produtoId, novaQtd);
            _estado = res.Estado;
            StateHasChanged();
        }
    }

    private async Task FinalizarPedidoManualmente()
    {
        var resultado = await VoiceService.FinalizarPedidoManualAsync(_estado);
        _estado = resultado.Estado;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = resultado.MensagemResposta });
        if (_falarRespostas) await JS.InvokeVoidAsync("voiceAssistant.speak", resultado.MensagemResposta);
        StateHasChanged();
    }

    private async Task EmitirNfeManualmente()
    {
        var resultado = await VoiceService.EmitirNfeManualAsync(_estado);
        _estado = resultado.Estado;
        _linkDanfe = resultado.LinkDanfe;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = resultado.MensagemResposta });
        if (_falarRespostas) await JS.InvokeVoidAsync("voiceAssistant.speak", resultado.MensagemResposta);
        StateHasChanged();
    }

    private void RecusarNfe()
    {
        _estado.Status = VoiceSessionStatus.Encerrado;
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Assistente",
            Texto = "Certo! O pedido está salvo. A NF-e poderá ser emitida posteriormente."
        });
        StateHasChanged();
    }

    private void ReiniciarSessao()
    {
        _estado = new VoiceSessionState();
        _mostrarFormCliente = false;
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Assistente",
            Texto = "Sessão reiniciada. O que você gostaria de fazer agora?"
        });
        StateHasChanged();
    }

    private Color ObterCorStatusSessao(VoiceSessionStatus status) => status switch
    {
        VoiceSessionStatus.AguardandoCliente => Color.Warning,
        VoiceSessionStatus.CriandoPedidoAguardandoItens => Color.Info,
        VoiceSessionStatus.AguardandoEscolhaProduto => Color.Secondary,
        VoiceSessionStatus.PedidoConcluidoAguardandoNfe => Color.Warning,
        VoiceSessionStatus.NfeEmitida => Color.Success,
        VoiceSessionStatus.Encerrado => Color.Dark,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            _dotNetRef.Dispose();
        }
    }
}
