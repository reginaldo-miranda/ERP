@using ERP.Application.Vendas.Voice
@using MudBlazor
@inject IVoiceAssistantService VoiceService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IAsyncDisposable

<!-- Botão Flutuante (FAB) de Microfone no Canto Inferior Direito -->
<div style="position: fixed; bottom: 28px; right: 28px; z-index: 1300;">
    <MudTooltip Text="Assistente de Voz / Copilot ERP">
        <MudBadge Dot="true" Color="@(_estaOuvindo ? Color.Error : Color.Success)" Overlap="true" Visible="true">
            <MudFab Color="@(_estaOuvindo ? Color.Error : Color.Primary)" 
                    StartIcon="@(_estaOuvindo ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicNone)" 
                    Size="Size.Large" 
                    OnClick="AlternarDrawer" 
                    Class="@(_estaOuvindo ? "pulse-animation" : "")" />
        </MudBadge>
    </MudTooltip>
</div>

<!-- Drawer Lateral do Assistente -->
<MudDrawer @bind-Open="_drawerAberto" Anchor="Anchor.Right" Elevation="5" Variant="DrawerVariant.Temporary" Width="440px">
    <div class="d-flex flex-column h-100" style="background: var(--mud-palette-background);">
        
        <!-- Header do Drawer -->
        <div class="pa-4 d-flex justify-space-between align-center border-b" style="background: var(--mud-palette-surface);">
            <div class="d-flex align-center gap-2">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Copilot por Voz</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pedidos de Venda &amp; NF-e</MudText>
                </div>
            </div>
            <div class="d-flex align-center gap-1">
                <MudTooltip Text="@(_falarRespostas ? "Desativar voz do assistente" : "Ativar voz do assistente")">
                    <MudIconButton Icon="@(_falarRespostas ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)" 
                                   Color="@(_falarRespostas ? Color.Primary : Color.Default)" 
                                   Size="Size.Small" 
                                   OnClick="@(() => _falarRespostas = !_falarRespostas)" />
                </MudTooltip>
                <MudTooltip Text="Novo Pedido / Limpar">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="ReiniciarSessao" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _drawerAberto = false)" />
            </div>
        </div>

        <!-- Conteúdo Rolável -->
        <div class="flex-grow-1 overflow-y-auto pa-4">
            
            <!-- Controle Principal de Microfone -->
            <MudPaper Class="pa-4 mb-4 text-center d-flex flex-column align-center justify-center" Elevation="2" Style="border-radius: 16px;">
                <MudIconButton Icon="@(_estaOuvindo ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicNone)" 
                               Color="@(_estaOuvindo ? Color.Error : Color.Primary)" 
                               Size="Size.Large" 
                               Variant="Variant.Filled" 
                               Class="@(_estaOuvindo ? "pulse-button mb-2" : "mb-2")" 
                               Style="width: 72px; height: 72px;"
                               OnClick="AlternarMicrofone" />

                <MudText Typo="Typo.body2" Class="font-weight-bold">
                    @(_estaOuvindo ? "Ouvindo... pode falar" : "Toque no microfone para falar")
                </MudText>

                @if (!string.IsNullOrWhiteSpace(_textoInterim))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 font-italic">
                        "@_textoInterim"
                    </MudText>
                }
                else if (_estaOuvindo)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Ex.: "faça um pedido para José Maria, 30 dias..."
                    </MudText>
                }
            </MudPaper>

            <!-- Card de Rascunho do Pedido em Tempo Real -->
            @if (_estado.Status != VoiceSessionStatus.AguardandoComando)
            {
                <MudCard Elevation="3" Class="mb-4 border-l-4" Style="border-left-color: var(--mud-palette-primary) !important;">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderContent>
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="mr-1" />
                                    @(_estado.PedidoCriadoNumero != null ? _estado.PedidoCriadoNumero : "Rascunho de Pedido")
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@ObterCorStatusSessao(_estado.Status)">
                                    @_estado.Status
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Cliente: <b>@(_estado.ClienteNome ?? "Não definido")</b> | Pagto: <b>@_estado.CondicaoPagamento</b>
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="pt-0">
                        @if (_estado.Itens.Any())
                        {
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                                <thead>
                                    <tr>
                                        <th>Qtd</th>
                                        <th>Produto</th>
                                        <th style="text-align: right;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _estado.Itens)
                                    {
                                        <tr>
                                            <td><b>@item.Quantidade</b></td>
                                            <td>@item.ProdutoNome</td>
                                            <td style="text-align: right;">@item.ValorTotal.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>

                            <div class="d-flex justify-space-between align-center mt-3 pt-2 border-t">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Total do Pedido:</MudText>
                                <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Success">@_estado.ValorTotal.ToString("C2")</MudText>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Aguardando itens... Diga: "10 unidades de Cimento..."</MudText>
                            </div>
                        }

                        <!-- Ações Rápidas por Botão de Acordo com o Estado -->
                        @if (_estado.Status == VoiceSessionStatus.CriandoPedidoAguardandoItens && _estado.Itens.Any())
                        {
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       FullWidth="true" 
                                       Class="mt-3" 
                                       StartIcon="@Icons.Material.Filled.Check" 
                                       OnClick="FinalizarPedidoManualmente">
                                Finalizar Pedido (ou diga "Finalizar")
                            </MudButton>
                        }
                        else if (_estado.Status == VoiceSessionStatus.PedidoConcluidoAguardandoNfe)
                        {
                            <div class="mt-3 pa-3 rounded" style="background: rgba(var(--mud-palette-success-rgb), 0.1);">
                                <MudText Typo="Typo.body2" Class="font-weight-bold text-success mb-2">
                                    Pedido Gerado! Deseja emitir a NF-e agora?
                                </MudText>
                                <div class="d-flex gap-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="EmitirNfeManualmente">
                                        Sim, Emitir NF-e
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" OnClick="RecusarNfe">
                                        Não
                                    </MudButton>
                                </div>
                            </div>
                        }
                        else if (_estado.Status == VoiceSessionStatus.NfeEmitida)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                                <b>NF-e Autorizada com sucesso!</b>
                                <div class="mt-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf" Href="@_linkDanfe" Target="_blank">
                                        Visualizar DANFE
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            }

            <!-- Histórico da Conversa -->
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 font-weight-bold text-uppercase d-block">Histórico da Conversa</MudText>
            <div class="d-flex flex-column gap-2 mb-4">
                @foreach (var msg in _mensagens)
                {
                    <div class="@(msg.Remetente == "Usuario" ? "align-self-end" : "align-self-start")" style="max-width: 85%;">
                        <MudPaper Class="@(msg.Remetente == "Usuario" ? "pa-3 mud-theme-primary" : "pa-3")" 
                                  Elevation="1" 
                                  Style="@(msg.Remetente == "Usuario" ? "border-radius: 12px 12px 2px 12px;" : "border-radius: 12px 12px 12px 2px;")">
                            <MudText Typo="Typo.caption" Class="d-block font-weight-bold" Style="@(msg.Remetente == "Usuario" ? "opacity: 0.85;" : "color: var(--mud-palette-primary);")">
                                @msg.Remetente • @msg.Horario.ToString("HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2">@msg.Texto</MudText>
                        </MudPaper>
                    </div>
                }
            </div>

        </div>

        <!-- Rodapé do Drawer com Input Manual de Texto -->
        <div class="pa-3 border-t d-flex gap-2" style="background: var(--mud-palette-surface);">
            <MudTextField @bind-Value="_textoDigitado" 
                          Placeholder="Ou digite o comando aqui..." 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Immediate="true"
                          OnKeyDown="@(async (e) => { if (e.Key == "Enter") await EnviarTextoManual(); })" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" OnClick="EnviarTextoManual" Disabled="@string.IsNullOrWhiteSpace(_textoDigitado)" />
        </div>

    </div>
</MudDrawer>

<style>
    .pulse-animation {
        animation: pulse-fab 1.5s infinite;
    }
    @@keyframes pulse-fab {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 14px rgba(239, 68, 68, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .pulse-button {
        animation: pulse-ring 1.5s infinite;
    }
    @@keyframes pulse-ring {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
</style>

@code {
    private bool _drawerAberto;
    private bool _estaOuvindo;
    private bool _falarRespostas = true;
    private string _textoInterim = string.Empty;
    private string _textoDigitado = string.Empty;
    private string? _linkDanfe;

    private VoiceSessionState _estado = new();
    private List<VoiceChatMessageDto> _mensagens = new();
    private DotNetObjectReference<VoiceAssistantDrawer>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Assistente",
            Texto = "Olá! Sou o seu Assistente de Voz do ERP. Diga algo como: 'ERP, faça um pedido de venda para o cliente José Maria da Silva, pagamento 30 dias'."
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("voiceAssistant.init", _dotNetRef);
        }
    }

    private async Task AlternarDrawer()
    {
        _drawerAberto = !_drawerAberto;
        if (_drawerAberto && !_estaOuvindo)
        {
            await IniciarEscuta();
        }
    }

    private async Task AlternarMicrofone()
    {
        if (_estaOuvindo)
            await PararEscuta();
        else
            await IniciarEscuta();
    }

    private async Task IniciarEscuta()
    {
        _textoInterim = string.Empty;
        await JS.InvokeVoidAsync("voiceAssistant.startListening");
    }

    private async Task PararEscuta()
    {
        await JS.InvokeVoidAsync("voiceAssistant.stopListening");
    }

    [JSInvokable]
    public void OnSpeechStateChanged(bool ouvindo)
    {
        _estaOuvindo = ouvindo;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInterimTranscript(string texto)
    {
        _textoInterim = texto;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnFinalTranscript(string textoFinal)
    {
        _textoInterim = string.Empty;
        if (!string.IsNullOrWhiteSpace(textoFinal))
        {
            await ProcessarComando(textoFinal);
        }
    }

    [JSInvokable]
    public void OnSpeechError(string erro)
    {
        _estaOuvindo = false;
        Snackbar.Add("Microfone: " + erro, Severity.Warning);
        StateHasChanged();
    }

    private async Task EnviarTextoManual()
    {
        if (string.IsNullOrWhiteSpace(_textoDigitado)) return;
        var texto = _textoDigitado.Trim();
        _textoDigitado = string.Empty;
        await ProcessarComando(texto);
    }

    private async Task ProcessarComando(string comando)
    {
        // 1. Adicionar mensagem do usuário
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Usuario",
            Texto = comando
        });
        StateHasChanged();

        try
        {
            // 2. Processar com o serviço
            var resultado = await VoiceService.ProcessarComandoVozAsync(_estado, comando);
            _estado = resultado.Estado;
            _linkDanfe = resultado.LinkDanfe;

            // 3. Adicionar resposta do assistente
            _mensagens.Add(new VoiceChatMessageDto
            {
                Remetente = "Assistente",
                Texto = resultado.MensagemResposta
            });

            // 4. Falar de volta se habilitado
            if (_falarRespostas && resultado.DeveFalar && !string.IsNullOrWhiteSpace(resultado.MensagemResposta))
            {
                await JS.InvokeVoidAsync("voiceAssistant.speak", resultado.MensagemResposta);
            }
        }
        catch (Exception ex)
        {
            _mensagens.Add(new VoiceChatMessageDto
            {
                Remetente = "Assistente",
                Texto = "Desculpe, ocorreu um erro ao processar seu comando: " + ex.Message,
                EhErro = true
            });
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task FinalizarPedidoManualmente()
    {
        var resultado = await VoiceService.FinalizarPedidoManualAsync(_estado);
        _estado = resultado.Estado;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = resultado.MensagemResposta });
        if (_falarRespostas) await JS.InvokeVoidAsync("voiceAssistant.speak", resultado.MensagemResposta);
        StateHasChanged();
    }

    private async Task EmitirNfeManualmente()
    {
        var resultado = await VoiceService.EmitirNfeManualAsync(_estado);
        _estado = resultado.Estado;
        _linkDanfe = resultado.LinkDanfe;
        _mensagens.Add(new VoiceChatMessageDto { Remetente = "Assistente", Texto = resultado.MensagemResposta });
        if (_falarRespostas) await JS.InvokeVoidAsync("voiceAssistant.speak", resultado.MensagemResposta);
        StateHasChanged();
    }

    private void RecusarNfe()
    {
        _estado.Status = VoiceSessionStatus.Encerrado;
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Assistente",
            Texto = "Certo! O pedido está salvo. A NF-e poderá ser emitida posteriormente."
        });
        StateHasChanged();
    }

    private void ReiniciarSessao()
    {
        _estado = new VoiceSessionState();
        _mensagens.Add(new VoiceChatMessageDto
        {
            Remetente = "Assistente",
            Texto = "Sessão reiniciada. O que você gostaria de fazer agora?"
        });
        StateHasChanged();
    }

    private Color ObterCorStatusSessao(VoiceSessionStatus status) => status switch
    {
        VoiceSessionStatus.CriandoPedidoAguardandoItens => Color.Info,
        VoiceSessionStatus.PedidoConcluidoAguardandoNfe => Color.Warning,
        VoiceSessionStatus.NfeEmitida => Color.Success,
        VoiceSessionStatus.Encerrado => Color.Dark,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            _dotNetRef.Dispose();
        }
    }
}
